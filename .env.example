# ==============================================================================
# Dandi Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY="change-me-to-a-secure-random-secret-key"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Groq API Configuration (Required for AI Assistant)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
PYDANTIC_AI_NO_BANNER=1
